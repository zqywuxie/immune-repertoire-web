# 配置参考。先运行 bash init-env.sh 生成带随机密钥的 .env，再修改端口。
# 不要直接使用下面的空密钥部署；真实 .env 不提交 Git。
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
ANALYSIS_FLAVOR=full
APP_DOCKERFILE=docker/app/Dockerfile.analysis
WEB_IMAGE_TAG=latest
FLASK_CONFIG=container
AUTH_REGISTER_ENABLED=true
# 首次部署创建管理员；已有管理员不会在重部署时修改密码。
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
API_CPUS=2
API_MEMORY_LIMIT=2g
WORKER_CONCURRENCY=2
WORKER_CPUS=4
WORKER_MEMORY_LIMIT=8g
ANALYSIS_NUM_THREADS=1
ANALYSIS_TIMEOUT_SECONDS=7200
WORKER_STOP_GRACE_PERIOD=2m
UPLOAD_MAX_MB=100
SECRET_KEY=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MONGO_PASSWORD=

# 服务器上分别执行 id -u zhengqinyun、id -g zhengqinyun，填写实际数值。
# 下列 10001 仅为兼容默认值，不代表该服务器用户的真实编号。
APP_UID=10001
APP_GID=10001
APP_STORAGE_USER=zhengqinyun
# 可选：绝对路径；省略则沿用原有 Docker 数据卷。
# APP_DATA_DIR=/colddata/SCigblast/platform/storage
# APP_UPLOAD_DIR=/colddata/SCigblast/platform/data
# APP_RESULTS_DIR=/colddata/SCigblast/platform/results

# 在本地单独构建并导入服务器的完整分析基础镜像。
ANALYSIS_RUNTIME_IMAGE=immune-analysis-runtime:3.20-v1
